# 线上部署环境变量模板
# 用法：cp deploy/.env.example .env，然后修改 DOMAIN 与 APP_SECRET_KEY
DOMAIN=your-domain.example.com
APP_ENV=production
APP_SECRET_KEY=replace-with-a-random-32-byte-hex
HTTPS_ONLY=true
TRUST_PROXY=true
JUDGE_MODE=docker
JUDGE_DOCKER_IMAGE=plg-judge:latest
JUDGE_CONCURRENCY=2
DATABASE_URL=sqlite:////app/data/app.db
